# PharmaInsightAI Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pharmainsight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharmainsight

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# LLM
GOOGLE_API_KEY=your-api-key-here
LLM_MODEL=gemini-3.0-flash-exp
LLM_PROVIDER=gemini

# Environment
ENVIRONMENT=development

# JWT Settings
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cookie Settings
COOKIE_SECURE=false

# Admin Seed (created on first startup)
ADMIN_EMAIL=admin@pharmainsight.io
ADMIN_PASSWORD=changeme123
TENANT_NAME=Default Tenant

# NCBI E-utilities (optional, for higher rate limits)
NCBI_API_KEY=
NCBI_TOOL=pharmainsightai
NCBI_EMAIL=admin@pharmainsight.io
